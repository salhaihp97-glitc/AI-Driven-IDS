# ============================================================================
# AI-IDS - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================
# NOTE: Only variables actually consumed by the application are listed here.
# Every key maps to a config.settings.Settings field / DEFAULT_ENV_VARS entry.

# --- Database ---
AI_IDS_DB_PATH=data/ai_ids.db

# --- Directories ---
AI_IDS_MODELS_DIR=models
AI_IDS_LOGS_DIR=logs
# Directory where live-capture flow CSVs are written (captured/cleaned master).
AI_IDS_CAPTURED_FLOWS_DIR=data

# --- Security (CHANGE THIS!) ---
AI_IDS_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# --- Telegram (optional) ---
AI_IDS_TELEGRAM_BOT_TOKEN=
AI_IDS_TELEGRAM_CHAT_ID=

# --- Auto-Block Policy & Protected Infrastructure ---
# Master kill-switch for the firewall auto-block reaction. When false, threats are
# still detected/altered but NO IP is ever blocked automatically.
AI_IDS_AUTO_BLOCK_ENABLED=true
# Comma-separated IP literals that must NEVER be auto-blocked or alerted on
# (e.g. infrastructure you manage). The capture host, its default gateway and the
# local subnet network/broadcast addresses are ALWAYS protected automatically —
# add anything extra here.
AI_IDS_PROTECTED_IPS=

# --- Detection / ML / Monitoring ---
AI_IDS_MONITORING_INTERVAL=5
AI_IDS_ALERT_WINDOW_MINUTES=10
AI_IDS_BCRYPT_ROUNDS=12

# --- Auto-Block Policy & Protected Infrastructure ---
# Master kill-switch for the automatic firewall blacklist-on-threat behaviour.
AI_IDS_AUTO_BLOCK_ENABLED=true
# Comma-separated IPs that must NEVER be auto-blocked or alert-spammed, in addition
# to the automatically-protected set (local interface IPs, default gateways, and each
# local subnet's network/broadcast address). Gateway/host addresses here stop the
# "Blacklisted IP ... attempting network access" alert storm from the VM bridge.
AI_IDS_PROTECTED_IPS=192.168.145.1

# --- Logging ---
AI_IDS_LOG_LEVEL=INFO

# --- Live Capture & Live Flows (all tunables are environment-driven) ---
# Flow engine: CICFlowMeter (pure-Python) is the sole backend for both live
# capture and offline PCAP analysis; no other extractor is supported.
AI_IDS_LIVE_CAPTURE_MODE=cicflowmeter
AI_IDS_FLOW_EXTRACTOR=cicflowmeter
# Seconds between idle-flow eviction sweeps by the background flusher thread.
AI_IDS_LIVE_FLUSH_POLL_SECONDS=2.0
# Max wait (seconds) for capture/flusher worker threads to unwind on stop.
AI_IDS_LIVE_SHUTDOWN_TIMEOUT_SECONDS=5.0
# Rolling window size of recent live flow records surfaced to the UI.
AI_IDS_LIVE_MAX_RECENT_FLOWS=500
# Gap (seconds) between packets that closes an active burst for CICIDS2017 Active/Idle stats.
AI_IDS_FLOW_ACTIVITY_TIMEOUT_SECONDS=5.0
# Seconds a flow may stay idle before it is evicted and evaluated.
AI_IDS_FLOW_IDLE_TIMEOUT=15
# Live Capture page polling: number of status refreshes and the interval between them.
AI_IDS_LIVE_UI_POLL_LOOPS=60
AI_IDS_LIVE_UI_POLL_INTERVAL=1.0
# Maximum number of recent flows rendered by the Live Flows page.
AI_IDS_LIVE_FLOWS_LIMIT=200

# --- Detection Signature Augmentation (Optional, Off by Default) ---
# The model is the sole classifier on every channel, including live capture.
# The signature rule engine is an OPT-IN augmentation for out-of-distribution
# patterns (e.g., loopback SYN floods with zero payload). Disabled by default so
# live verdicts are pure model outputs with no heuristic overrides.
# AI_IDS_SIG_SYN_FLOOD_MIN_SYN=50
# AI_IDS_SIG_SYN_FLOOD_MAX_PAYLOAD_BYTES=500
# AI_IDS_SIG_SYN_FLOOD_MIN_FWD_SYN_RATIO=0.8
# AI_IDS_SIG_PORT_SCAN_MIN_DST_PORTS=40
# AI_IDS_SIG_PORT_SCAN_WINDOW_SECONDS=60
# AI_IDS_SIG_PORT_SCAN_COOLDOWN_SECONDS=300
# AI_IDS_SIG_CONFIDENCE=0.9
# AI_IDS_SIG_LOW_CONFIDENCE_BENIGN_THRESHOLD=0.60

# --- Macro-Flow Assembly (Required for flood/scan detection) ---
# Aggregates many tiny flows sharing a key (src_ip, dst_ip, dst_port, protocol --
# deliberately excluding src_port) over a sliding window so flood footprints that are
# invisible per-flow (rotating-source-port SYN floods) physically reach the model.
# When enabled, assembled macro-flow units are classified by the model registered under
# AI_IDS_MACRO_FLOW_MODEL_ID instead of the per-flow classifier.
#   id 5 = Macro RF V1   (Random Forest, 4 classes)
#   id 6 = Macro XGB V1  (XGBoost GBM, 4 classes)
#   id 7 = Macro RF V2   (Random Forest, 7 classes — includes DoS Hulk / Slowhttptest / SSH-Patator)
#   id 8 = Macro XGB V2  (XGBoost GBM, 7 classes — recommended, best MCC)
# V2 models are trained on true macro-aggregate vectors PLUS the three application-layer
# families (DoS Hulk, DoS Slowhttptest, SSH-Patator) that V1 cannot label. Recommended = 8.
# IMPORTANT: MUST stay true for the system to detect SYN floods / port scans from Kali.
# The per-flow CICIDS2017 models cannot see floods that exist only across flows.
AI_IDS_MACRO_FLOW_ENABLED=true
AI_IDS_MACRO_FLOW_WINDOW_SECONDS=10.0
AI_IDS_MACRO_FLOW_KEY_FIELDS=src_ip,dst_ip,dst_port,protocol
AI_IDS_MACRO_FLOW_MIN_MEMBERS=2
AI_IDS_MACRO_FLOW_MODEL_ID=8
